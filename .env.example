# Public site URL. Used for canonical URLs, Open Graph, the sitemap and robots.txt.
# Inlined at build time: it must be set when running `next build`, not only at start.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Base URL of the Django PMS REST API, with no trailing slash.
# When unset: forms log to the server console in development and show the
# error state in production, so leads are never silently dropped.
PMS_API_URL=
# Optional token, sent as "Authorization: Token <value>".
PMS_API_TOKEN=
